<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ESG Screener | EcoMetrics</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', system-ui, sans-serif; }
    body { background-color: #0b0f19; color: #f3f4f6; min-height: 100vh; display: flex; flex-direction: column; }
    
    header { background: #111827; border-bottom: 1px solid #1f2937; padding: 0.8rem 2rem; display: flex; justify-content: space-between; align-items: center; }
    .brand-section { display: flex; align-items: center; gap: 2rem; }
    .brand { font-size: 1.3rem; font-weight: 800; color: #10b981; text-decoration: none; }
    
    .nav-links { display: flex; gap: 1rem; list-style: none; }
    .nav-links a { color: #9ca3af; text-decoration: none; font-size: 0.95rem; font-weight: 500; padding: 6px 12px; border-radius: 6px; transition: 0.2s; }
    .nav-links a:hover, .nav-links a.active { color: #10b981; background: rgba(16,185,129,0.1); }

    .user-info { display: flex; align-items: center; gap: 15px; color: #9ca3af; font-size: 0.9rem; }
    .logout-btn { background: #ef4444; color: white; text-decoration: none; padding: 6px 14px; border-radius: 6px; font-weight: 600; }

    main { max-width: 1000px; width: 100%; margin: 2rem auto; padding: 0 1rem; flex: 1; }
    .hero { text-align: center; margin-bottom: 2rem; }
    .hero h1 { font-size: 2.2rem; color: #ffffff; }
    .hero p { color: #9ca3af; margin-top: 6px; }

    .search-wrapper { position: relative; max-width: 650px; margin: 0 auto 2.5rem auto; }
    .search-input { width: 100%; padding: 16px 20px; border-radius: 12px; border: 1px solid #374151; background: #1f2937; color: #fff; font-size: 1rem; outline: none; }
    .search-input:focus { border-color: #10b981; }

    .dropdown { position: absolute; top: 105%; left: 0; right: 0; background: #1f2937; border: 1px solid #374151; border-radius: 12px; display: none; z-index: 100; max-height: 280px; overflow-y: auto; }
    .dropdown-item { padding: 12px 18px; cursor: pointer; border-bottom: 1px solid #2d3748; display: flex; justify-content: space-between; align-items: center; }
    .dropdown-item:hover { background: #374151; }
    .ticker { font-weight: 700; color: #10b981; background: rgba(16,185,129,0.1); padding: 3px 8px; border-radius: 4px; }
    .comp-name { color: #e5e7eb; font-weight: 500; margin-left: 8px; }

    .card { background: #111827; border: 1px solid #1f2937; border-radius: 14px; padding: 1.5rem; }
    table { width: 100%; border-collapse: collapse; text-align: left; }
    th, td { padding: 12px 16px; border-bottom: 1px solid #1f2937; }
    th { background: #1f2937; color: #9ca3af; font-size: 0.8rem; text-transform: uppercase; }
    .badge { padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 700; background: rgba(16,185,129,0.15); color: #34d399; }
    .analyze-btn { color: #38bdf8; text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>

  <header>
    <div class="brand-section">
      <a href="/screener" class="brand">🌱 EcoMetrics</a>
      <ul class="nav-links">
        <li><a href="/screener" class="active">Screener</a></li>
        <li><a href="/compare">Compare</a></li>
        <li><a href="/company/AAPL">Analysis</a></li>
      </ul>
    </div>
    <div class="user-info">
      <span><%= user ? user.name : 'Analyst' %></span>
      <a href="/logout" class="logout-btn">Logout</a>
    </div>
  </header>

  <main>
    <div class="hero">
      <h1>ESG Stock & Corporate Screener</h1>
      <p>Search live market companies or private enterprises for ESG analysis</p>
    </div>

    <div class="search-wrapper">
      <input type="text" id="searchInput" class="search-input" placeholder="Type company or ticker (e.g. Reliance, Deloitte, INFY, AAPL)..." autocomplete="off" />
      <div id="dropdown" class="dropdown"></div>
    </div>

    <div class="card">
      <h2 style="margin-bottom: 1rem; font-size: 1.1rem;">Top Rated ESG Companies</h2>
      <table>
        <thead>
          <tr>
            <th>Ticker</th>
            <th>Company</th>
            <th>ESG Rating</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span class="ticker">MSFT</span></td>
            <td>Microsoft Corp.</td>
            <td><span class="badge">92 / 100</span></td>
            <td><a href="/company/MSFT" class="analyze-btn">Analyze →</a></td>
          </tr>
          <tr>
            <td><span class="ticker">AAPL</span></td>
            <td>Apple Inc.</td>
            <td><span class="badge">88 / 100</span></td>
            <td><a href="/company/AAPL" class="analyze-btn">Analyze →</a></td>
          </tr>
          <tr>
            <td><span class="ticker">TSLA</span></td>
            <td>Tesla Inc.</td>
            <td><span class="badge">79 / 100</span></td>
            <td><a href="/company/TSLA" class="analyze-btn">Analyze →</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    const input = document.getElementById('searchInput');
    const dropdown = document.getElementById('dropdown');

    input.addEventListener('input', async (e) => {
      const q = e.target.value.trim();
      if (q.length < 1) {
        dropdown.style.display = 'none';
        return;
      }

      try {
        const res = await fetch(`/api/companies/search?query=${encodeURIComponent(q)}`);
        const list = await res.json();

        if (list.length === 0) {
          dropdown.innerHTML = '<div style="padding:14px; text-align:center; color:#9ca3af;">No companies found</div>';
        } else {
          dropdown.innerHTML = list.map(c => `
            <div class="dropdown-item" onclick="window.location.href='/company/${c.symbol}'">
              <div>
                <span class="ticker">${c.symbol}</span>
                <span class="comp-name">${c.name}</span>
              </div>
              <span style="color:#6b7280; font-size:0.8rem;">${c.exchange}</span>
            </div>
          `).join('');
        }
        dropdown.style.display = 'block';
      } catch (err) {
        console.error("Search error:", err);
      }
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !dropdown.contains(e.target)) dropdown.style.display = 'none';
    });
  </script>

</body>
</html>